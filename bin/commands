#!/bin/bash

update_mirrorlist(){
	sudo reflector --verbose -l 5 --sort rate --save /etc/pacman.d/mirrorlist
}

pacman_remove_orphan(){
	sudo pacman -Rns $(pacman -Qtdq)
}

gb_keyboard(){
	setxkbmap -layout gb
	localectl set-keymap --no-convert gb
}

br_keyboard(){
	setxkbmap -layout br
	localectl set-keymap --no-convert br
}

us_keyboard(){
	setxkbmap -layout us
	localectl set-keymap --no-convert us
}

prev() {
  PREV=$(fc -lrn | head -n 1)
  sh -c "pet new `printf %q "$PREV"`"
}

milli_to_date(){

	for var in "$@"
	do
    		echo "$var"
		printf '\t' ; TZ=UTC date -d @$(  echo "($var + 500) / 1000" | bc)
		printf '\t' ; TZ=Europe/London date -d @$(  echo "($var + 500) / 1000" | bc)
	done
}

snapshot_version(){
	printf "0.%s-SNAPSHOT" $(git rev-parse --short HEAD)
}

snapshot_image(){
	printf "0.%s" $(git rev-parse HEAD)
}

# Prompts for optional description and runs git commit.
# Usage: _ci_commit "title" ["#deploytodev"]
_ci_commit(){
	local title="$1"
	local suffix="${2:-}"
	printf "Enter to confirm (d=inline description, e=editor, ctrl-c to cancel): '$title' "
	read confirm

	if [[ "$confirm" == "d" ]]; then
		printf "Description: "
		read description
		git commit -m "${title}${suffix:+ $suffix}" -m "$description"
	elif [[ "$confirm" == "e" ]]; then
		local tmpfile=$(mktemp /tmp/git_commit_msg.XXXXXX)
		printf "%s\n\n# Write description below (lines starting with # are ignored)\n" "$title" > "$tmpfile"
		${EDITOR:-vi} "$tmpfile"
		local parsed_title=$(sed -n '1p' "$tmpfile")
		local parsed_body=$(sed '1,2d; /^#/d' "$tmpfile")
		rm -f "$tmpfile"
		if [[ -n "$parsed_body" ]]; then
			git commit -m "${parsed_title}${suffix:+ $suffix}" -m "$parsed_body"
		else
			git commit -m "${parsed_title}${suffix:+ $suffix}"
		fi
	else
		git commit -m "${title}${suffix:+ $suffix}"
	fi
}

ci(){
	local message="$*"
	_ci_commit "$message"
	if [ $? -eq 0 ];then
		printf "Done\n"
	else
		printf "Commit failed\n"
	fi
}

ci_and_push(){
	local message="$*"
	_ci_commit "$message"
	if [ $? -eq 0 ];then
		git push origin
	else
		printf "Commit failed\n"
	fi
}

ci_and_push_and_deploy(){
	local message="$*"
	_ci_commit "$message" "#deploytodev"
	if [ $? -eq 0 ];then
		git push origin
	else
		printf "Commit failed\n"
	fi
}

keyboard_bluetooth(){
	echo -e "connect 70:F0:87:29:75:8F\n" | bluetoothctl
}

headphone_bluetooth(){
	echo -e "connect 40:EF:4C:D2:83:7A\n" | bluetoothctl
}

change_mac() {
  local net=${1:-en0}
  local mac=$(openssl rand -hex 6 | sed 's/\(..\)/\1:/g; s/.$//')
  sudo ifconfig $net ether $mac
  sudo ifconfig $net down
  sudo ifconfig $net up
  echo "Your new physical address for interface $net is $mac"
}

tmux_title() {
	tmux rename-window $1
	export svc=$(tmux display-message -p '#W')
}

# changing directory with cdd
# if folder contains .git then it sets tmux title to the folder name
# and it sets 'svc' environment variable to the same
cdd() {
    cd "$@" || return

    if [[ -d .git ]]
    then
        tmux_title $(basename $PWD)
    fi
}
